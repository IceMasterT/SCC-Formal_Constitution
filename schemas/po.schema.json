{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scc.po.v1",
  "type": "object",
  "required": [
    "schema_version",
    "checker_version",
    "step_id",
    "mode",
    "dom",
    "inv",
    "identity",
    "governance",
    "risk",
    "audit",
    "isolation",
    "refinement",
    "prev_state_hash",
    "next_state_hash",
    "event_hash",
    "audit_event_hash",
    "authorized_meta_path",
    "recovery_path",
    "witness_refs"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string" },
    "checker_version": { "type": "string" },
    "step_id": { "type": "string" },
    "mode": { "enum": ["Exact", "Stutter", "SafeRefined"] },
    "dom": { "type": "boolean" },
    "inv": { "type": "boolean" },
    "identity": { "type": "boolean" },
    "governance": { "type": "boolean" },
    "risk": { "type": "boolean" },
    "audit": { "type": "boolean" },
    "isolation": { "type": "boolean" },
    "refinement": { "type": "boolean" },
    "prev_state_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "next_state_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "event_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "audit_event_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "authorized_meta_path": { "type": "boolean" },
    "recovery_path": { "type": "boolean" },
    "witness_refs": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
