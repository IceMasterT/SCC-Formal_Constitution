{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scc.state.v1",
  "type": "object",
  "required": [
    "schema_version",
    "state_id",
    "step",
    "compute_root",
    "memory_root",
    "vector_clock",
    "governance_weights",
    "failure_mode",
    "audit_hash",
    "risk_vector",
    "lineage_root",
    "protected_root"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string" },
    "state_id": { "type": "string" },
    "step": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "compute_root": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "memory_root": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "vector_clock": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
    },
    "governance_weights": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "number" }
    },
    "failure_mode": { "type": "integer", "minimum": 0, "maximum": 3 },
    "audit_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "risk_vector": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "number" }
    },
    "lineage_root": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "protected_root": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
